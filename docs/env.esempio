# Copia questo file in .env.local (non va nel repository) e riempi i valori. Poi riavvia con: npx expo start -c
# Server AI (Cloudflare Worker con la chiave di Gemini)
EXPO_PUBLIC_AI_URL=https://NOME-DEL-WORKER.TUO-ACCOUNT.workers.dev
EXPO_PUBLIC_AI_TOKEN=la-stessa-parola-d-ordine-di-APP_TOKEN-nel-worker

# Server account e dati (Supabase). Senza questi due l'app resta in «modalità di prova»: nessun account vero, nessun social, nessun accesso con Google/Apple.
# I valori sono nel pannello Supabase: Project Settings > API. L'indirizzo è il «Project URL»; la chiave è quella PUBBLICA («Publishable key» / anon). Mai la chiave «service_role» o «secret».
EXPO_PUBLIC_SUPABASE_URL=https://IL-TUO-PROGETTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=la-chiave-pubblica-del-progetto
# Facoltativo: quali accessi proporre (altrimenti: iPhone = apple,google; Android = google). I pulsanti compaiono solo se il server li ha attivi.
# EXPO_PUBLIC_OAUTH_PROVIDERS=google,apple
