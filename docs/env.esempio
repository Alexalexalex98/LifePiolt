# Copia questo file in .env.local (non va nel repository) e riempi i valori. Poi riavvia con: npx expo start -c
# Server AI (Cloudflare Worker con la chiave di Gemini)
EXPO_PUBLIC_AI_URL=https://NOME-DEL-WORKER.TUO-ACCOUNT.workers.dev
EXPO_PUBLIC_AI_TOKEN=la-stessa-parola-d-ordine-di-APP_TOKEN-nel-worker
